# Settings shared by every script in scripts/.

# Your GCP project ID (not the project name) - find it with: gcloud projects list
# Either replace the placeholder below, or set it per shell: export PROJECT_ID=my-project-id
PROJECT_ID="${PROJECT_ID:-your-project-id}"

# Region for Cloud Run and Artifact Registry
REGION="us-central1"

# Artifact Registry Docker repository that stores the images
REPO="cloud-run-lab"

# Cloud Run service name (also used as the image name)
SERVICE="hello-cloud-run"

# Scaling and resources, applied on every deploy
MIN_INSTANCES=0     # 0 = scale to zero when idle, so no cost with no traffic
MAX_INSTANCES=3     # hard cap on scale-out (also caps cost)
CONCURRENCY=80      # max simultaneous requests per container instance
CPU=1
MEMORY="512Mi"
TIMEOUT="30s"       # max time a single request may take
